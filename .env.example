# Chat App — Environment Configuration
# Edit these values, then restart the server.

PORT=3000

# Partner 1
PARTNER1_CODE=PARTNER-A
PARTNER1_NAME=Partner 1

# Partner 2
PARTNER2_CODE=PARTNER-B
PARTNER2_NAME=Partner 2

# Optional: Klipy API key for GIF search (free at https://partner.klipy.com)
# Note: Google shut down Tenor API on June 30, 2026. Klipy is the free replacement.
# Klipy is Tenor-compatible and free with no usage caps.
KLIPY_API_KEY=

# Auto-cleanup: delete media older than N days (0 = disabled)
CLEANUP_PHOTOS_DAYS=30
CLEANUP_VIDEOS_DAYS=14
CLEANUP_AUDIO_DAYS=30
CLEANUP_GIFS_DAYS=30
CLEANUP_INTERVAL_HOURS=24
